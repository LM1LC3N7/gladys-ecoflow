{
  "name": "gladys-ecoflow",
  "version": "0.3.0",
  "private": true,
  "description": "Gladys Assistant external integration to monitor and control EcoFlow power stations (River 2 family), via the official Open Platform API or a simple email/password login.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=85"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecoflow-api/schemas": "^0.7.0",
    "@gladysassistant/integration-sdk": "^0.14.0",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
